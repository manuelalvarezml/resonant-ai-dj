{
  "$defs": {
    "BPMConstraint": {
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 400,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Minimum"
        },
        "maximum": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 400,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum"
        },
        "source_span": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Span",
          "type": "string"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "source_span"
      ],
      "title": "BPMConstraint",
      "type": "object"
    },
    "EvidenceGap": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "origin": {
          "description": "explicit_requirement means a HARD user requirement and MUST have blocking=true. Soft explicit wishes use optional_preference. Contextual caveats use inferred_context.",
          "enum": [
            "explicit_requirement",
            "optional_preference",
            "inferred_context"
          ],
          "title": "Origin",
          "type": "string"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "explanation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "concept",
        "origin",
        "blocking",
        "explanation"
      ],
      "title": "EvidenceGap",
      "type": "object"
    },
    "Preference": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "$ref": "#/$defs/AllowedTag"
        },
        "direction": {
          "enum": [
            "increase",
            "decrease"
          ],
          "title": "Direction",
          "type": "string"
        },
        "importance": {
          "enum": [
            "primary",
            "secondary",
            "optional"
          ],
          "title": "Importance",
          "type": "string"
        },
        "origin": {
          "enum": [
            "explicit",
            "inferred"
          ],
          "title": "Origin",
          "type": "string"
        },
        "source_span": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Span"
        }
      },
      "required": [
        "tag",
        "direction",
        "importance",
        "origin",
        "source_span"
      ],
      "title": "Preference",
      "type": "object"
    },
    "TagConstraint": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "all",
            "any",
            "exclude"
          ],
          "title": "Mode",
          "type": "string"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/AllowedTag"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        },
        "source_span": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Source Span",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "tags",
        "source_span"
      ],
      "title": "TagConstraint",
      "type": "object"
    },
