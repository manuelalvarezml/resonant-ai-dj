  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "playlist-intent-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "ready",
        "partial_support",
        "needs_clarification",
        "unsupported"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "interpretation": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Interpretation",
      "type": "string"
    },
    "occasion": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Occasion"
    },
    "activity": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Activity"
    },
    "recipient": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Recipient"
    },
    "emotional_goal": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Emotional Goal"
    },
    "constraints": {
      "description": "Explicit hard requirements only. EMPTY for ordinary creative mood/activity/occasion prompts. any mode accepts genre alternatives only.",
      "items": {
        "$ref": "#/$defs/TagConstraint"
      },
      "maxItems": 30,
      "title": "Constraints",
      "type": "array"
    },
    "bpm": {
      "anyOf": [
        {
          "$ref": "#/$defs/BPMConstraint"
        },
        {
          "type": "null"
        }
      ]
    },
    "preferences": {
      "items": {
        "$ref": "#/$defs/Preference"
      },
      "maxItems": 30,
      "title": "Preferences",
      "type": "array"
    },
    "count": {
      "maximum": 100,
      "minimum": 1,
      "title": "Count",
      "type": "integer"
    },
    "count_source": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Count Source"
    },
    "order": {
      "enum": [
        "relevance",
        "bpm_ascending",
        "bpm_descending"
      ],
      "title": "Order",
      "type": "string"
    },
    "order_source": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Order Source"
    },
    "excluded_track_ids": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 100,
      "title": "Excluded Track Ids",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10,
      "title": "Assumptions",
      "type": "array"
    },
    "evidence_gaps": {
      "items": {
        "$ref": "#/$defs/EvidenceGap"
      },
      "maxItems": 20,
      "title": "Evidence Gaps",
      "type": "array"
    },
    "clarification": {
      "anyOf": [
        {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Clarification"
    }
  },
  "required": [
    "schema_version",
    "disposition",
    "interpretation",
    "occasion",
    "activity",
    "recipient",
    "emotional_goal",
    "constraints",
    "bpm",
    "preferences",
    "count",
    "count_source",
    "order",
    "order_source",
    "excluded_track_ids",
    "assumptions",
    "evidence_gaps",
    "clarification"
  ],
  "title": "IntentPlan",
  "type": "object"
}
