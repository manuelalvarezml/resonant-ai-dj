{
  "name": "@resonant/web-player",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "dev:web": "node scripts/serve.mjs --web --port 4174",
    "build:web": "node scripts/build.mjs --web",
    "start:cloud": "node scripts/serve-cloud.mjs",
    "export:cloud": "node scripts/export-release.mjs",
    "smoke:cloud": "node scripts/cloud-smoke.mjs"
  }
}
