{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Resonant global edge; us-east-1; explicitly FREE subscription",
  "Parameters": {
    "MediaDomain": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9.-]+\\.s3\\.us-east-2\\.amazonaws\\.com"
    },
    "HttpApiId": {
      "Type": "String",
      "AllowedPattern": "[a-z0-9]+"
    },
    "CookiePublicKey": {
      "Type": "String"
    },
    "OriginSecret": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 40,
      "MaxLength": 128
    },
    "CustomDomain": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(|[a-z0-9.-]+)"
    },
    "CertificateArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(|arn:aws:acm:us-east-1:[0-9]{12}:certificate/[a-z0-9-]+)"
    }
  },
  "Resources": {
    "WebACL": {
      "Type": "AWS::WAFv2::WebACL",
      "Properties": {
        "Scope": "CLOUDFRONT",
        "DefaultAction": {
          "Allow": {}
        },
        "VisibilityConfig": {
          "SampledRequestsEnabled": false,
          "CloudWatchMetricsEnabled": true,
          "MetricName": "resonant-edge"
        },
        "Rules": [
          {
            "Name": "ip-flood-limit",
            "Priority": 0,
            "Action": {
              "Block": {}
            },
            "Statement": {
              "RateBasedStatement": {
                "Limit": 6000,
                "AggregateKeyType": "IP",
                "EvaluationWindowSec": 300
              }
            },
            "VisibilityConfig": {
              "SampledRequestsEnabled": false,
              "CloudWatchMetricsEnabled": true,
              "MetricName": "resonant-ip-flood"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "resonant"
          }
        ]
      }
    },
    "PublicKey": {
      "Type": "AWS::CloudFront::PublicKey",
      "Properties": {
        "PublicKeyConfig": {
          "CallerReference": {
            "Fn::Sub": "${AWS::StackName}-cookie-key"
          },
          "Name": {
            "Fn::Sub": "${AWS::StackName}-cookie-key"
          },
          "EncodedKey": {
            "Ref": "CookiePublicKey"
          }
        }
      }
    },
    "KeyGroup": {
      "Type": "AWS::CloudFront::KeyGroup",
      "Properties": {
        "KeyGroupConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-listeners"
          },
          "Items": [
            {
              "Ref": "PublicKey"
            }
          ]
        }
      }
    },
    "OAC": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-s3"
          },
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "Entry": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-entry"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Sign-in navigation for expired document sessions",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) { var r=event.request; if(r.uri!=='/' && r.uri!=='/index.html') return r; var p=r.cookies['CloudFront-Policy']; var valid=false; try { var raw=p.value.replace(/-/g,'+').replace(/_/g,'=').replace(/~/g,'/'); var policy=JSON.parse(Buffer.from(raw,'base64').toString()); valid=policy.Statement[0].Condition.DateLessThan['AWS:EpochTime']>Date.now()/1000; } catch(e) {} if(!valid) return {statusCode:302,headers:{location:{value:'/login/index.html'},'cache-control':{value:'no-store'}}}; return r; }"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "Resonant private shared library",
          "DefaultRootObject": "index.html",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "ViewerCertificate": {
            "Fn::If": [
              "HasCustomDomain",
              {
                "AcmCertificateArn": {
                  "Ref": "CertificateArn"
                },
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": "TLSv1.2_2021"
              },
              {
                "CloudFrontDefaultCertificate": true
              }
            ]
          },
          "WebACLId": {
            "Fn::GetAtt": [
              "WebACL",
              "Arn"
            ]
          },
          "Origins": [
            {
              "Id": "s3",
              "DomainName": {
                "Ref": "MediaDomain"
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              },
              "OriginAccessControlId": {
                "Ref": "OAC"
              }
            },
            {
              "Id": "api",
              "DomainName": {
                "Fn::Sub": "${HttpApiId}.execute-api.us-east-2.amazonaws.com"
              },
              "CustomOriginConfig": {
                "OriginProtocolPolicy": "https-only",
                "OriginSSLProtocols": [
                  "TLSv1.2"
                ]
              },
              "OriginCustomHeaders": [
                {
                  "HeaderName": "X-Resonant-Origin",
                  "HeaderValue": {
                    "Ref": "OriginSecret"
                  }
                }
              ]
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "s3",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "Entry",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CacheBehaviors": [
            {
              "TargetOriginId": "api",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD",
                "OPTIONS",
                "PUT",
                "PATCH",
                "POST",
                "DELETE"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "Compress": true,
              "CachePolicyId": "4135ea2d-6df8-44a3-9df3-4b5a84be39ad",
              "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
              "PathPattern": "/api/*",
              "OriginRequestPolicyId": "b689b0a8-53d0-40ab-baf2-68738e2966ac"
            },
            {
              "TargetOriginId": "s3",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "Compress": true,
              "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
              "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
              "PathPattern": "/login/*"
            },
            {
              "TargetOriginId": "s3",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "Compress": true,
              "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
              "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
              "TrustedKeyGroups": [
                {
                  "Ref": "KeyGroup"
                }
              ],
              "PathPattern": "/library/*"
            },
            {
              "TargetOriginId": "s3",
              "ViewerProtocolPolicy": "redirect-to-https",
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "CachedMethods": [
                "GET",
                "HEAD"
              ],
              "Compress": true,
              "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
              "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
              "TrustedKeyGroups": [
                {
                  "Ref": "KeyGroup"
                }
              ],
              "PathPattern": "/media/*"
            }
          ],
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ErrorCachingMinTTL": 0
            },
            {
              "ErrorCode": 404,
              "ErrorCachingMinTTL": 0
            }
          ],
          "Aliases": {
            "Fn::If": [
              "HasCustomDomain",
              [
                {
                  "Ref": "CustomDomain"
                }
              ],
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "resonant"
          }
        ]
      }
    },
    "FreeSubscription": {
      "Type": "AWS::PricingPlanManager::Subscription",
      "Properties": {
        "PlanFamily": "CloudFront",
        "PlanTier": "FREE",
        "UsageLevel": "DEFAULT",
        "ResourceArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
          },
          {
            "Fn::GetAtt": [
              "WebACL",
              "Arn"
            ]
          }
        ]
      }
    }
  },
  "Outputs": {
    "Domain": {
      "Value": {
        "Fn::GetAtt": [
          "Distribution",
          "DomainName"
        ]
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "DistributionArn": {
      "Value": {
        "Fn::Sub": "arn:${AWS::Partition}:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
      }
    },
    "KeyPairId": {
      "Value": {
        "Ref": "PublicKey"
      }
    },
    "SubscriptionStatus": {
      "Value": {
        "Fn::GetAtt": [
          "FreeSubscription",
          "Status"
        ]
      }
    },
    "SubscriptionArn": {
      "Value": {
        "Ref": "FreeSubscription"
      }
    }
  },
  "Conditions": {
    "HasCustomDomain": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CustomDomain"
            },
            ""
          ]
        }
      ]
    }
  }
}
