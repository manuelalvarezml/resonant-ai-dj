{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Resonant Ohio foundation; no public objects or compute",
  "Parameters": {
    "WebOrigin": {
      "Type": "String",
      "Default": "https://unpublished.invalid",
      "AllowedPattern": "https://[a-z0-9.-]+"
    },
    "DistributionArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(|arn:aws:cloudfront::[0-9]{12}:distribution/[A-Z0-9]+)"
    },
    "AdditionalWebOrigin": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(|https://[a-z0-9.-]+)"
    }
  },
  "Resources": {
    "MediaBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "resonant"
          }
        ],
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "abort-incomplete",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketName": {
          "Fn::Sub": "resonant-${AWS::AccountId}-${AWS::Region}-${AWS::StackName}-media"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "StateBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "resonant"
          }
        ],
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "abort-incomplete",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            },
            {
              "Id": "requests",
              "Prefix": "requests/",
              "Status": "Enabled",
              "ExpirationInDays": 7
            },
            {
              "Id": "results",
              "Prefix": "results/",
              "Status": "Enabled",
              "ExpirationInDays": 7
            },
            {
              "Id": "audits",
              "Prefix": "audits/",
              "Status": "Enabled",
              "ExpirationInDays": 7
            },
            {
              "Id": "text-cache",
              "Prefix": "text-cache/",
              "Status": "Enabled",
              "ExpirationInDays": 30
            }
          ]
        },
        "BucketName": {
          "Fn::Sub": "resonant-${AWS::AccountId}-${AWS::Region}-${AWS::StackName}-state"
        },
        "CorsConfiguration": {
          "CorsRules": [
            {
              "AllowedOrigins": [
                {
                  "Ref": "WebOrigin"
                },
                {
                  "Fn::If": [
                    "HasAdditionalOrigin",
                    {
                      "Ref": "AdditionalWebOrigin"
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                }
              ],
              "AllowedMethods": [
                "GET",
                "HEAD"
              ],
              "AllowedHeaders": [
                "*"
              ],
              "ExposedHeaders": [
                "ETag"
              ],
              "MaxAge": 300
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ArtifactBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "resonant"
          }
        ],
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "abort-incomplete",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "BucketName": {
          "Fn::Sub": "resonant-${AWS::AccountId}-${AWS::Region}-${AWS::StackName}-artifacts"
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "MediaBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "MediaBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "MediaBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${MediaBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Fn::If": [
                "HasEdge",
                {
                  "Effect": "Allow",
                  "Action": "s3:GetObject",
                  "Resource": {
                    "Fn::Sub": "${MediaBucket.Arn}/*"
                  },
                  "Principal": {
                    "Service": "cloudfront.amazonaws.com"
                  },
                  "Condition": {
                    "StringEquals": {
                      "AWS:SourceArn": {
                        "Ref": "DistributionArn"
                      }
                    }
                  }
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          ]
        }
      }
    },
    "StateBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "StateBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "StateBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${StateBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "ArtifactBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "ArtifactBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "ArtifactBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${ArtifactBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "State": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "OnDemandThroughput": {
          "MaxReadRequestUnits": 50,
          "MaxWriteRequestUnits": 25
        },
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "DeletionProtectionEnabled": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "resonant"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "HttpApi": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "ProtocolType": "HTTP",
        "DisableExecuteApiEndpoint": false
      }
    }
  },
  "Outputs": {
    "MediaBucket": {
      "Value": {
        "Ref": "MediaBucket"
      }
    },
    "StateBucket": {
      "Value": {
        "Ref": "StateBucket"
      }
    },
    "ArtifactBucket": {
      "Value": {
        "Ref": "ArtifactBucket"
      }
    },
    "State": {
      "Value": {
        "Ref": "State"
      }
    },
    "HttpApi": {
      "Value": {
        "Ref": "HttpApi"
      }
    },
    "MediaDomain": {
      "Value": {
        "Fn::GetAtt": [
          "MediaBucket",
          "RegionalDomainName"
        ]
      }
    }
  },
  "Conditions": {
    "HasEdge": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "DistributionArn"
            },
            ""
          ]
        }
      ]
    },
    "HasAdditionalOrigin": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "AdditionalWebOrigin"
            },
            ""
          ]
        }
      ]
    }
  }
}
